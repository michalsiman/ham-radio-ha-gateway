# Hamlib model number: `rigctl -l | grep -i 7300` → 3073 for the Icom IC-7300.
RIG_MODEL=3073
# The radio's serial port. Use the stable /dev/serial/by-id/... name, see docs/04-rigctld.md.
RIG_DEVICE=/dev/serial/by-id/CHANGE-ME
# Must match the radio's CI-V USB baud rate.
RIG_SPEED=115200
# 127.0.0.1: only programs on this Pi. 0.0.0.0: also e.g. a logger on your PC.
RIGCTLD_LISTEN=127.0.0.1
